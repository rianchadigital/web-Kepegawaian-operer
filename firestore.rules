rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Pegawai collection (identitas pribadi, operasional, foto profil)
    match /pegawai/{pegawaiId} {
      allow read, write: if true;
    }

    // Disiplin collection
    match /disiplin/{disiplinId} {
      allow read, write: if true;
    }

    // Usulan collection
    match /usulan/{usulanId} {
      allow read, write: if true;
    }

    // Jadwal Diklat collection
    match /jadwal_diklat/{jadwalId} {
      allow read, write: if true;
    }

    // Gap Kompetensi collection
    match /gap_kompetensi/{gapId} {
      allow read, write: if true;
    }

    // Master Data collection
    match /master_data/{docId} {
      allow read, write: if true;
    }

    // Pengguna / Auth collection
    match /pengguna/{userId} {
      allow read, write: if true;
    }

    // Connection test collection
    match /test/{docId} {
      allow read, write: if true;
    }

    // App Configuration collection (GAS Web App URL, instansi settings)
    match /app_config/{configId} {
      allow read, write: if true;
    }
  }
}


